# Caddy — local/preview edge.
#
#   :81      the web app        → localhost:3000
#   api.     the API service    → localhost:4000   (public origin, see below)
#
# The API is a separate service now, so the browser calls it cross-origin and
# the API answers its own CORS preflights. Caddy fronts it so production keeps
# one TLS-terminating public entry point per origin.
#
# This is the SEPARATE-ORIGINS topology (local / self-hosted). On Vercel the two
# services share ONE domain through the rewrites in the root vercel.json, so
# nothing below applies there.

(forwarded) {
	header_up Host {host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Real-IP {remote_host}
}

# ── Web app ────────────────────────────────────────────────────────────────
:81 {
	# No `?XTransformPort=` passthrough: it proxied ANY local port (anvil's
	# unlocked admin RPC included) to anyone who asked.
	reverse_proxy localhost:3000 {
		import forwarded
	}
}

# ── API ────────────────────────────────────────────────────────────────────
# The API reads the client IP for rate limiting (apps/api/src/lib/rate-limit.ts
# keys on x-forwarded-for), so these headers are load-bearing, not decorative.
# Do not expose this origin without a rate limit in front of it: the API trusts
# the forwarded IP that Caddy sets.
api.{
	reverse_proxy localhost:4000 {
		import forwarded
	}
}
