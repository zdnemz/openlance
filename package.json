{
  "name": "openlance",
  "version": "0.1.0",
  "private": true,
  "description": "OpenLance monorepo — web (Next.js), api (Hono), contracts (Hardhat)",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @openlance/web dev",
    "dev:api": "pnpm --filter @openlance/api dev",
    "chain": "bash scripts/anvil/dev-real.sh",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @openlance/web build",
    "build:api": "pnpm --filter @openlance/api build",
    "build:contracts": "pnpm --filter @openlance/contracts build",
    "start": "pnpm --parallel -r start",
    "start:web": "pnpm --filter @openlance/web start",
    "start:api": "pnpm --filter @openlance/api start",
    "serve:web": "pnpm --filter @openlance/web serve",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:routes": "pnpm --filter @openlance/api check:routes",
    "gen:routes": "pnpm --filter @openlance/api gen:routes",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @openlance/api db:migrate",
    "db:setup": "pnpm db:migrate",
    "export:abi": "pnpm --filter @openlance/contracts export:abi",
    "verify:notifications": "pnpm --filter @openlance/api verify:notifications",
    "check:job-bid": "pnpm --filter @openlance/api check:job-bid",
    "check:sponsored-value": "pnpm --filter @openlance/api check:sponsored-value",
    "check:notification-rows": "pnpm --filter @openlance/api check:notification-rows",
    "check:envelope": "pnpm --filter @openlance/api check:envelope",
    "clean": "pnpm -r clean",
    "postinstall": "node scripts/link-env.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "@eslint/js": "^9",
    "typescript-eslint": "^8",
    "eslint": "^9",
    "globals": "^16",
    "eslint-config-next": "^16.1.1"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "apps/api/**/*.ts": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  }
}
