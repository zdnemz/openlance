# ── Deployment ────────────────────────────────────────────────────────────────
# Base Sepolia RPC (public endpoint works without a key; Alchemy/Infura for
# rate limits and etherscan verification).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer private key — testnet only. Fund it from a Base Sepolia faucet.
# On anvil you can use the deterministic dev account #0:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_KEY=

# ── Timelock / ownership ─────────────────────────────────────────────────────
# Seconds between scheduling and executing an upgrade. 172800 = 48h (default on
# public networks; the deploy script uses a short delay on localhost).
# TIMELOCK_DELAY=172800
# The address that should ultimately own the timelock (a Safe multisig on
# mainnet). Defaults to the deployer.
# FINAL_ADMIN=0x...
# Initial platform fee in basis points (default 250 = 2.5%, cap 500 = 5%).
# INITIAL_FEE_BPS=250

# ── Verification (optional) ──────────────────────────────────────────────────
ETHERSCAN_API_KEY=
