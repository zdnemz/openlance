# OpenLance — environment. Copy to .env.local and fill in.
# The API runs inside this Next.js app (route handlers under /api).

# ── Database (required) — Supabase Postgres or any Postgres ────────────────
DATABASE_URL=postgresql://user:password@host:5432/openlance
# DATABASE_POOL_MAX=10

# ── Upstash Redis (optional) — SIWE nonces, JWT denylist, rate limits, cache
# Absent → in-process memory fallback (single-instance dev only).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# ── Supabase (optional) — Storage + Realtime ────────────────────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxxx
# SUPABASE_JWT_SECRET=change-me-min-16-chars        # required in production

# ── Public origin (SIWE domain + CORS) ──────────────────────────────────────
# APP_URI=http://localhost:3000

# ── Chain indexer (defaults to a mock chain; zero-infra) ────────────────────
# CHAIN_MODE=real
# CHAIN_ID=84532                                     # Base Sepolia
# CHAIN_RPC_URL=https://sepolia.base.org
# ESCROW_ADDRESS=0x...
# ARBITER_REGISTRY_ADDRESS=0x...
# ADMIN_WALLETS=0x...,0x...

# ── File storage (Supabase Storage when configured, else local disk) ────────
# STORAGE_DRIVER=supabase
# STORAGE_BUCKET=project-files
