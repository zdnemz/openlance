# EscrowLance frontend — all vars optional, sane defaults for the local devnet stack.

# Chain RPC used by the server-side JSON-RPC relay (default: http://127.0.0.1:8545)
# ANVIL_RPC_URL=http://127.0.0.1:8545

# Port of the Hono API (default: 3030; the gateway path is /api with ?XTransformPort)
# NEXT_PUBLIC_API_PORT=3030
