# OpenLance — environment. Copy to .env.local and fill in.
#
# ONE file for the whole monorepo. `pnpm install` symlinks it into apps/web
# (Next only reads .env* from its own directory) and apps/api. In CI and
# containers there is no file — the environment arrives from the platform.
#
#   apps/web   Next.js UI          :3000
#   apps/api   Hono API service    :4000   ← owns auth, DB, chain indexer
#   apps/contracts  Hardhat (Solidity)   ← keeps its own .env, not this one
#
# Per-service annotated references:
#   apps/api/.env.example        everything below, owned by the API
#   apps/web/.env.example        NEXT_PUBLIC_API_BASE only
#   apps/contracts/.env.example  deploy key + RPC (a separate file)
#
# This root file is the copy target for web + api. Contracts keeps its own
# .env beside its package, because Hardhat reads it from the package cwd.
#
# Two deployment shapes (the origin variables below depend on which):
#   - Separate origins: `pnpm dev`, Caddy / self-hosted. Web and API each have
#     their own origin; the browser calls the API cross-origin.
#   - Vercel services: ONE project, ONE domain. The root vercel.json rewrites
#     /api/* to the api service and everything else to the web service, so
#     both are the same origin. See "Deploying on Vercel" in the README.
#
# ── Vercel (services) checklist — set these in the project's env ────────────
# Environment variables belong to the PROJECT, not to a service: Vercel
# documents no per-service scoping, so assume both services see all of them
# (inferred). Set them for Production AND Preview. The web service reads none of
# the secrets, and only NEXT_PUBLIC_* is ever inlined into the browser bundle.
#   APP_URI, API_URI       the one public origin, https://<domain> (same value)
#   COOKIE_DOMAIN          leave UNSET (host-only gate cookies)
#   NEXT_PUBLIC_API_BASE   leave UNSET (the web build defaults it to same-origin)
#   DATABASE_URL           Supabase POOLER url (port 6543) + DATABASE_POOL_MAX=1
#   SUPABASE_JWT_SECRET    >= 16 chars; the API refuses to start without it
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN   required on serverless
#   STORAGE_DRIVER=supabase + SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   MAX_UPLOAD_BYTES       <= 4194304 (Vercel rejects request bodies over ~4.5 MB)
#   CRON_SECRET            >= 16 chars, plus an external pinger (see below)
#   chain: CHAIN_MODE, CHAIN_ID, CHAIN_RPC_URL, the contract addresses,
#          INDEXER_START_BLOCK (required when CHAIN_MODE=real off 31337), ADMIN_WALLETS
# Do not set NODE_ENV or PORT (Vercel sets NODE_ENV; PORT is only for serve.ts).

# ── Database (required) — Supabase Postgres or any Postgres ────────────────
DATABASE_URL=postgresql://user:password@host:5432/openlance
# DATABASE_POOL_MAX=10
#
# SERVERLESS (Vercel): use the Supabase *pooler* URL (transaction mode, port
# 6543) and set DATABASE_POOL_MAX=1. A Vercel Function opens its own postgres-js
# pool per cold start and they do not share, so the default of 10 multiplies by
# every concurrent instance and exhausts the connection limit (the pooler is
# what makes that survivable). Do NOT append `?pgbouncer=true`: that is a Prisma
# flag, postgres-js forwards unknown URL parameters to the server as startup
# parameters, and the client already sets `prepare: false`
# (apps/api/src/db/index.ts), which is what a transaction pooler needs.
# Migrations are not part of the Vercel build: run `pnpm db:migrate` against the
# DIRECT (non-pooler) URL, which needs real sessions, before promoting a release
# that adds apps/api/drizzle/*.sql.

# ── Upstash Redis (optional locally, REQUIRED on Vercel) ────────────────────
# SIWE nonces, JWT denylist, rate limits, cache. Absent → in-process memory
# fallback (single-instance dev only). On a serverless host every request may
# land on a different instance, so a SIWE nonce issued by one is unknown to the
# next and sign-in fails intermittently; /api/ready still reports ok.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# ── Supabase (optional) — Storage + Realtime ────────────────────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=xxxx                             # browser/realtime (public)
# SUPABASE_SERVICE_ROLE_KEY=xxxx                     # server-only (storage admin)
# SUPABASE_JWT_SECRET=change-me-min-16-chars         # required in production
# SUPABASE_PROJECT_REF=xxxx                          # inferred from SUPABASE_URL

# ── Public origins (SIWE domain + CORS) ────────────────────────────────────
# APP_URI is the WEB app — SIWE domain check (the domain is this URL's HOST, so
# it must equal the host users actually browse) and the API's CORS allowlist.
# API_URI is THIS API — used to build absolute upload/signed-file URLs.
# NEXT_PUBLIC_API_BASE is read by the web app at BUILD time to call the API.
# PORT is the API's listen port (src/serve.ts only; unused on Vercel).
# APP_URI=http://localhost:3000
# API_URI=http://localhost:4000
# NEXT_PUBLIC_API_BASE=http://localhost:4000
# PORT=4000
#
# VERCEL SERVICES (one project, one domain): the origin is shared, so
#   APP_URI=https://<the one public domain>
#   API_URI=https://<the one public domain>     # same value as APP_URI
#   NEXT_PUBLIC_API_BASE                        # leave UNSET
# Unset, the web build defaults NEXT_PUBLIC_API_BASE to the empty string (same
# origin) when it builds on Vercel, so `localhost:4000` is never baked into the
# bundle. Do NOT point it at a separate API origin, and delete any value left
# over from an old two-project setup — it would silently put every call back
# on a second origin. A *.vercel.app host works as the public domain as long as
# APP_URI is that exact host. A Preview deployment has its own hostname, so
# sign-in on a Preview shows the APP_URI domain in the SIWE message (wallets may
# warn about the mismatch); the production domain is the one that matches.

# Gate cookies (el_onboarded / el_role) are stamped by the API but read by the
# web app's edge proxy. Cookies ignore ports, so localhost works host-only.
# On ONE origin (Vercel services) they are host-only and just work: leave
# COOKIE_DOMAIN UNSET. A value that does not domain-match the public host (for
# example `.vercel.app`, a public suffix) is rejected by the browser, the gate
# cookie is never stored, and every visitor is redirected to /onboarding forever
# with no error anywhere.
# With SEPARATE origins on different hosts in production (app.example.com +
# api.example.com), set the shared registrable domain instead — without it every
# visitor is stuck on /onboarding.
# COOKIE_DOMAIN=.example.com

# ── Notifications & webhooks (PRD F9) ───────────────────────────────────────
# Outbound webhook delivery tuning (defaults shown).
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=5
# Inbound event receiver (POST /api/internal/inbound). Unset → endpoint disabled.
# Senders sign the raw body: HMAC-SHA256 → X-OpenLance-Signature: sha256=<hex>
# INBOUND_WEBHOOK_SECRET=change-me-min-16-chars
# GET /api/internal/cron — runs the chain indexer, SLA scan, webhook delivery
# and the nightly reconcile. Bearer-authed with CRON_SECRET (min 16 chars);
# unset → 404.
# REQUIRED on a serverless host (Vercel): the in-process setInterval scheduling
# in workers/bootstrap.ts only starts from src/serve.ts and cannot fire once a
# function is frozen, so an EXTERNAL scheduler (cron-job.org, QStash, GitHub
# Actions — not Vercel Cron) must ping this route instead. On the Vercel
# services layout the API shares the web app's domain, so point it at that:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        https://<public-domain>/api/internal/cron
# as often as the scheduler allows. Those schedulers typically bottom out at
# about a minute (GitHub Actions: several minutes, best effort), so the mirror
# lags the chain by that much; INDEXER_POLL_MS (~10s) only paces the in-process
# timers of a long-lived host, it does not apply here. If the production domain
# sits behind Vercel Deployment Protection the pinger needs the protection-bypass
# header. Leave CRON_SECRET unset on a long-lived host, where the built-in
# intervals already do the work.
# CRON_SECRET=change-me-min-16-chars

# ── Chain indexer (defaults to a mock chain; zero-infra) ────────────────────
# CHAIN_MODE=real
# CHAIN_ID=84532                                     # Base Sepolia
# CHAIN_RPC_URL=https://sepolia.base.org
# Keyless, browser-facing node URL, published on /overview so the wallet is
# pointed at the chain itself instead of the API relay (which dies whenever the
# API restarts, and 502s outright outside dev). MUST NOT carry an API key —
# /overview is public. Unset → the wallet keeps its current endpoint.
# Local devnet: CHAIN_RPC_PUBLIC_URL=http://127.0.0.1:8545
# CHAIN_RPC_PUBLIC_URL=
# ESCROW_ADDRESS=0x...
# ARBITER_REGISTRY_ADDRESS=0x...
# The wallet-owned seat. Set it and `users.role` becomes a mirror: sign-in
# re-seats from the chain, and a role write is refused unless the wallet has
# already claimed that seat on-chain (so a wiped DB cannot hand out a new one).
# Unset → no on-chain seat on this deployment; the DB column decides, as before.
# ROLE_REGISTRY_ADDRESS=0x...
# First block the indexer reads — the block deploy.ts prints. Required on any
# public chain (CHAIN_ID ≠ 31337), or the API refuses to boot rather than scan
# from genesis.
# INDEXER_START_BLOCK=
# TIMELOCK_ADDRESS=0x...                             # owns the UUPS proxies
# ADMIN_WALLETS=0x...,0x...
# Staking mirrors (must match contracts/scripts/deploy.ts): prod 7d/3d,
# local (hardhat) 60s/60s. After an on-chain retune the indexer KV overrides env.
# MIN_STAKE_DURATION_SECONDS=604800
# UNSTAKE_COOLDOWN_SECONDS=259200
# Dispute windows (must match deploy.ts): prod 86400/86400/172800,
# local 120/120/600. Events carry no timestamps — the indexer derives deadlines.
# COMMIT_WINDOW_SECONDS=86400
# REVEAL_WINDOW_SECONDS=86400
# APPEAL_WINDOW_SECONDS=172800

# ── Gasless sponsorship (ERC-2771 forwarder + server relayer) ───────────────
# Signed-in users sign ONE EIP-712 SponsorshipSession voucher at login; every
# money action is then submitted as a meta-tx by the relayer, which pays gas
# (+ principal on testnet). Both vars are required to enable it; unset → money
# actions fall back to normal user-paid gas.
# SPONSORSHIP_FORWARDER_ADDRESS=0x...   # from the deploy script output
# RELAYER_PRIVATE_KEY=0x...             # server-only testnet key; NEVER expose
# SPONSORSHIP_SESSION_TTL_SECONDS=43200 # default: mirrors SESSION_TTL_SECONDS
# SPONSORSHIP_RATE_LIMIT_PER_HOUR=60    # per-user drain guard

# ── Storage system (Supabase Storage when configured, else local disk) ──────
# Auto-selects `supabase` when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
#
# SERVERLESS (Vercel): `local` is unusable — the function filesystem is
# ephemeral and per-instance, so uploads vanish on the next cold start and no
# later request can read them. Set STORAGE_DRIVER=supabase explicitly.
# STORAGE_DRIVER=supabase                            # supabase | local
# STORAGE_BUCKET=project-files
# STORAGE_BUCKET_VISIBILITY=private                  # private | public
# STORAGE_PREFIX=                                    # object-key namespace, e.g. prod/
# STORAGE_ALLOWED_MIME=                              # CSV override of the default allowlist
# STORAGE_LOCAL_DIR=./data/uploads                   # local-driver disk root
# MAX_UPLOAD_BYTES=26214400                          # default 25 MiB, or 4 MiB when VERCEL is set; keep <= 4194304 on Vercel, whose Functions reject request bodies over ~4.5 MB (uploads stream through PUT /api/files/:id/raw)
# SIGNED_URL_TTL_SECONDS=120                         # signed upload/download lifetime
