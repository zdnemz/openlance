### EscrowLance API — golden-path walkthrough (VS Code REST Client / JetBrains HTTP client)
### Start with: bun run db:setup && bun run dev  →  base URL http://localhost:3030
### SIWE logins need a signed message — scripts/smoke.ts does this programmatically
### (it signs with the seeded demo keys). These calls assume you grabbed a token
### from smoke output or the future frontend. Public calls work with no auth.

### ── Status ────────────────────────────────────────────────────────────
GET http://localhost:3030/health

###
GET http://localhost:3030/ready

###
GET http://localhost:3030/overview

### ── Marketplace (public reads) ───────────────────────────────────────
GET http://localhost:3030/jobs?status=open&limit=10

###
GET http://localhost:3030/jobs?category=web3-frontend

### ── Auth: SIWE ───────────────────────────────────────────────────────
# 1. get a nonce (single-use, 10 min TTL)
POST http://localhost:3030/auth/nonce

### 2. build the EIP-4361 message with the returned nonce (domain must be
#    localhost:3000, chainId 84532), sign it with a wallet, then:
POST http://localhost:3030/auth/verify
Content-Type: application/json

{
  "message": "localhost:3000 wants you to sign in with your Ethereum account:\n0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266\n\nSign in to EscrowLance - milestone escrow for freelance work.\n\nURI: http://localhost:3000\nVersion: 1\nChain ID: 84532\nNonce: PASTE_NONCE\nIssued At: 2026-09-18T00:00:00.000Z",
  "signature": "0x_PASTE_SIGNATURE"
}

### 3. use the token
GET http://localhost:3030/auth/me
Authorization: Bearer PASTE_TOKEN

### ── Job posting (client token) ───────────────────────────────────────
POST http://localhost:3030/jobs
Authorization: Bearer CLIENT_TOKEN
Content-Type: application/json

{
  "title": "Design a landing page for our protocol",
  "description": "We need a single-page marketing site for a DeFi protocol. Copy exists, you own the design and implementation.",
  "category": "design",
  "skills": ["figma", "tailwind"],
  "budgetMin": "0.5",
  "budgetMax": "1.2",
  "milestones": [
    { "title": "Wireframes", "description": "Two directions to choose from.", "amount": "0.4" },
    { "title": "Final implementation", "description": "Responsive build + handoff.", "amount": "0.6" }
  ]
}

### ── Proposal (freelancer token) ──────────────────────────────────────
POST http://localhost:3030/jobs/JOB_ID/proposals
Authorization: Bearer FREELANCER_TOKEN
Content-Type: application/json

{
  "coverNote": "I've shipped five protocol landing pages; my last one is on the Arbitrum ecosystem hub.",
  "deliveryDays": 14,
  "milestones": [
    { "title": "Wireframes", "description": "Two directions to choose from.", "amount": "0.4" },
    { "title": "Final implementation", "description": "Responsive build + handoff.", "amount": "0.6" }
  ]
}

### ── Award (client token) → project + milestones are created ──────────
POST http://localhost:3030/proposals/PROPOSAL_ID/accept
Authorization: Bearer CLIENT_TOKEN

### ── Project view with fund tx hints ──────────────────────────────────
GET http://localhost:3030/projects/PROJECT_ID
Authorization: Bearer CLIENT_TOKEN

### ── Chat ─────────────────────────────────────────────────────────────
POST http://localhost:3030/projects/PROJECT_ID/messages
Authorization: Bearer FREELANCER_TOKEN
Content-Type: application/json

{ "body": "Kicking off — wireframes by Friday." }

###
GET http://localhost:3030/projects/PROJECT_ID/messages
Authorization: Bearer CLIENT_TOKEN

### ── Dev chain (mock mode only — stands in for wallet txs) ────────────
POST http://localhost:3030/dev/chain/fund
Content-Type: application/json

{ "milestoneId": "MILESTONE_ID" }

###
POST http://localhost:3030/dev/chain/submit
Content-Type: application/json

{ "milestoneId": "MILESTONE_ID" }

###
POST http://localhost:3030/dev/chain/approve
Content-Type: application/json

{ "milestoneId": "MILESTONE_ID" }

### ── Reviews (unlocked by settlement) ─────────────────────────────────
POST http://localhost:3030/milestones/MILESTONE_ID/reviews
Authorization: Bearer CLIENT_TOKEN
Content-Type: application/json

{ "rating": 5, "body": "Great work, fast iterations." }

### ── Dispute flow on milestone 2 ──────────────────────────────────────
POST http://localhost:3030/projects/PROJECT_ID/milestones/MILESTONE_2_ID/disputes
Authorization: Bearer FREELANCER_TOKEN
Content-Type: application/json

{ "reason": "Client expanded scope beyond the milestone brief; we disagree on the extra work." }

###
POST http://localhost:3030/dev/chain/dispute
Content-Type: application/json

{ "milestoneId": "MILESTONE_2_ID", "by": "0x70997970c51812dc3a010c7d01b50e0d17dc79c8" }

### both sides propose the same arbiter → status becomes "agreed"
POST http://localhost:3030/disputes/DISPUTE_ID/arbiter-proposal
Authorization: Bearer CLIENT_TOKEN
Content-Type: application/json

{ "arbiterAddress": "0x9965507d1a55bcc2695c58ba16fb37d819b0a4dc" }

###
POST http://localhost:3030/dev/chain/resolve
Content-Type: application/json

{ "milestoneId": "MILESTONE_2_ID", "arbiter": "0x9965507d1a55bcc2695c58ba16fb37d819b0a4dc", "outcome": "split", "withinSla": true }

### ── Trust + ledger ───────────────────────────────────────────────────
GET http://localhost:3030/arbiters

###
GET http://localhost:3030/ledger?limit=20

###
GET http://localhost:3030/ledger/summary

### ── Webhooks (set URL to a Discord webhook or a request-bin) ─────────
POST http://localhost:3030/webhooks
Authorization: Bearer CLIENT_TOKEN
Content-Type: application/json

{ "url": "https://discord.com/api/webhooks/...", "eventTypes": [] }
