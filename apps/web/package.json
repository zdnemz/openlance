{
  "name": "@openlance/web",
  "version": "0.1.0",
  "private": true,
  "description": "OpenLance web — Next.js App Router UI",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 12321",
    "build": "next build && node scripts/finalize-standalone.mjs",
    "build:vercel": "next build",
    "start": "next start -p 12321",
    "serve": "node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:login": "tsx scripts/check-login-signatures.ts",
    "check:eip712": "tsx scripts/check-eip712-payload.ts",
    "check:gasless": "tsx scripts/check-gasless-value.ts",
    "check:file-url": "tsx scripts/check-file-url.ts",
    "check:api-base": "tsx scripts/check-api-base.ts",
    "check:job-redirect": "tsx scripts/check-job-redirect.ts",
    "check:funding-refresh": "tsx scripts/check-funding-refresh.ts",
    "check:chain-busy": "tsx scripts/check-chain-busy.ts",
    "check:dispute-round": "tsx scripts/check-dispute-round.ts",
    "check:eth-precision": "tsx scripts/check-eth-precision.ts",
    "check:dashboard-drafts": "tsx scripts/check-dashboard-drafts.tsx",
    "check:provider-error": "tsx scripts/check-provider-error.ts",
    "check:wallet-rpc": "tsx scripts/check-wallet-rpc.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.82.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "next": "^16.1.1",
    "pixelarticons": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "viem": "^2.56.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
