# ── Deployment ────────────────────────────────────────────────────────────────
# Base Sepolia RPC (public endpoint works without a key; Alchemy/Infura for
# rate limits and etherscan verification).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer private key — testnet only. Fund it from a Base Sepolia faucet.
# On anvil you can use the deterministic dev account #0:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_KEY=

# ── Timelock / ownership ─────────────────────────────────────────────────────
# Seconds between scheduling and executing an upgrade. 172800 = 48h (default on
# public networks; the deploy script uses a short delay on localhost).
# TIMELOCK_DELAY=172800
# The address that should ultimately own the timelock (a Safe multisig on
# mainnet). Defaults to the deployer.
# FINAL_ADMIN=0x...
# Initial platform fee in basis points (default 250 = 2.5%, cap 500 = 5%).
# INITIAL_FEE_BPS=250
# Receives slashed stake and, unless SPONSORSHIP_WALLET is set, pays relayer
# principal. Both default to FINAL_ADMIN when unset.
# TREASURY=0x...
# SPONSORSHIP_WALLET=0x...

# ── Constructor parameters (baked into the deployed contracts) ──────────────
# These become immutable on-chain, so changing one means a redeploy. The API
# reads the same values from its own env (apps/api/.env.example) to mirror
# deadlines and fees in the UI — change both together or the two drift.
# Defaults differ per network: the script uses short windows on localhost and
# production values everywhere else. Shown here are the production values.
# MIN_STAKE_WEI=100000000000000000        # 0.1 ETH  (local: same)
# MIN_SCORE_TO_WITHDRAW=50                # trust score floor to unlock a stake
# MIN_STAKE_DURATION_SECONDS=604800       # 7d  (local: 60)
# UNSTAKE_COOLDOWN_SECONDS=259200         # 3d  (local: 60)
# DISPUTE_FEE_WEI=50000000000000000       # 0.05 ETH
# COMMIT_WINDOW_SECONDS=86400             # 24h (local: 120)
# REVEAL_WINDOW_SECONDS=86400             # 24h (local: 120)
# APPEAL_WINDOW_SECONDS=172800            # 48h (local: 600)

# ── Verification (optional) ──────────────────────────────────────────────────
ETHERSCAN_API_KEY=
