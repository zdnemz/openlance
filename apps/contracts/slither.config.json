# Slither configuration.
#
# Run: slither . --hardhat-ignore-compile
#
# The production contracts (contracts/Escrow.sol, contracts/ArbiterRegistry.sol)
# have no High/Medium findings. The excluded detectors below are known
# false-positives in OpenZeppelin libraries or intentional patterns; each is
# justified in SECURITY.md.

detectors:
  exclude:
    # OZ Math.mulDiv / ERC1967Utils internals — audited library code.
    - incorrect-exp
    - divide-before-multiply
    - msg-value-in-nonpayable
    - unused-return
    # Escrow._pay is a push payment to the milestone's own client/freelancer,
    # validated at fund(); withdrawFees is owner+timelock gated. Intentional.
    - arbitrary-send-eth
    # OZ TimelockController receives ETH by design; the test attacker is a
    # deliberate reentrancy probe.
    - locked-ether
    # Dispute windows use block.timestamp on purpose (48h/72h/24h coordination).
    - timestamp
    # The test-only attacker reenters on purpose; Escrow is guarded.
    - reentrancy-benign
    - reentrancy-events
    - calls-loop

# Only report on our contracts, not the vendored OZ tree or test helpers.
filter_paths:
  - node_modules
  - contracts/test
