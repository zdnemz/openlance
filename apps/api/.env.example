# OpenLance API — environment. See also ../.env.example (shared root file).
#
# The API owns the real configuration: auth, database, chain indexer, storage,
# webhooks. Every variable is validated once in src/config.ts (zod) — a bad
# value logs loudly and falls back to the default rather than crashing.
#
# Runtime note: `pnpm install` symlinks the repo-root `.env.local` here, so
# there is ONE file to edit for the whole monorepo. This file is the annotated
# reference for the values this service reads. Server-only: nothing here is
# exposed to the browser, and RELAYER_PRIVATE_KEY must never leave this host.

# ── Database (required) — Supabase Postgres or any Postgres ────────────────
# Nothing works without it: auth, ledger, disputes, jobs and the indexer all
# read and write here. `pnpm db:migrate` pushes the schema.
DATABASE_URL=postgresql://user:password@host:5432/openlance
# DATABASE_POOL_MAX=10

# ── Upstash Redis (optional locally, REQUIRED on Vercel) — SIWE nonces, JWT
# denylist, rate limits, cache, and the worker queue. Absent → in-process memory
# fallback, which is single-instance dev only: workers and nonces die with the
# process. On a serverless host every request may land on a different instance,
# so a SIWE nonce issued by one is "unknown or expired" on the next and sign-in
# fails intermittently. /api/ready still reports ok for the memory fallback, so
# the misconfiguration is silent.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# ── Supabase (optional locally, REQUIRED on Vercel) — Storage + Realtime ────
# Without these, uploads fall back to local disk under STORAGE_LOCAL_DIR, which
# does not work on a serverless host (read-only / per-instance filesystem).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=xxxx                             # browser/realtime (public)
# SUPABASE_SERVICE_ROLE_KEY=xxxx                     # server-only (storage admin)
# SUPABASE_JWT_SECRET=change-me-min-16-chars         # REQUIRED in production
# SUPABASE_PROJECT_REF=xxxx                          # inferred from SUPABASE_URL

# ── Public origins ─────────────────────────────────────────────────────────
# APP_URI is the WEB app: SIWE domain check (the domain is this URL's HOST, so
# it must equal the host users actually browse) and this API's CORS allowlist.
# API_URI is THIS API: used to build absolute upload / signed-file URLs.
# PORT is read directly by src/serve.ts (not the zod schema) and is the only
# value that will not appear in `config.ts`. Unused on Vercel, which runs
# src/app.ts as a Function instead.
# APP_URI=http://localhost:3000
# API_URI=http://localhost:4000
# PORT=4000

# Gate cookies (el_onboarded / el_role) are stamped here but read by the web
# app's edge proxy. Cookies ignore ports, so localhost works host-only.
#
# Two deployment shapes:
#
#  1. VERCEL SERVICES (one project, one domain): the root vercel.json rewrites
#     /api/* to this service and everything else to the web app, so both are
#     the same origin.
#       APP_URI=https://<the one public domain>
#       API_URI=https://<the one public domain>   # same value as APP_URI
#       COOKIE_DOMAIN                              # leave UNSET
#     Unset, the gate cookies are host-only on that domain, which is exactly
#     where the web proxy reads them. Never set COOKIE_DOMAIN here: a value that
#     does not domain-match the public host (e.g. `.vercel.app`, a public
#     suffix) is rejected by the browser, the gate cookie is never stored, and
#     every visitor is stuck on the onboarding page. *.vercel.app hosts work as
#     the public domain, as long as APP_URI is that exact host. CORS is not
#     exercised (same-origin), and the web build must NOT point
#     NEXT_PUBLIC_API_BASE at a different origin (see apps/web/.env.example).
#
#  2. SEPARATE ORIGINS (pnpm dev, Caddy, or web + API as two projects on
#     subdomains): the browser calls this API cross-origin, so APP_URI must be
#     the web origin (CORS allowlist) and the web app needs NEXT_PUBLIC_API_BASE
#     pointing here. When the two sit on different hosts in production, set the
#     shared registrable domain:
# COOKIE_DOMAIN=.example.com

# ── Notifications & webhooks (PRD F9) ───────────────────────────────────────
# Outbound webhook delivery tuning (defaults shown).
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=5
# Inbound event receiver (POST /api/internal/inbound). Unset → endpoint disabled.
# Senders sign the raw body: HMAC-SHA256 → X-OpenLance-Signature: sha256=<hex>
# INBOUND_WEBHOOK_SECRET=change-me-min-16-chars
# GET /api/internal/cron — runs the chain indexer (real mode), SLA scan, webhook
# delivery and the nightly reconcile. Bearer-authed with CRON_SECRET (min 16
# chars); unset → 404. REQUIRED on a serverless host (Vercel): the in-process
# intervals in workers/bootstrap.ts only start from src/serve.ts, never from the
# serverless entrypoint src/app.ts, and cannot fire once a Function is frozen.
# Drive it from an EXTERNAL pinger (cron-job.org, QStash, GitHub Actions) — not
# Vercel Cron — against the public domain, which is the same host as the web
# app because /api/* is rewritten to this service:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        https://<public-domain>/api/internal/cron
# Leave unset on a long-lived host, where the built-in intervals already work.
# CRON_SECRET=change-me-min-16-chars

# ── Chain indexer (defaults to a mock chain; zero-infra) ────────────────────
# CHAIN_MODE=real
# CHAIN_ID=84532                                     # Base Sepolia
# CHAIN_RPC_URL=https://sepolia.base.org
# Keyless, browser-facing node URL published on /overview so the wallet talks to
# the chain directly rather than through this API (which restarts under --watch
# and fails closed in production). Never put an API key here: /overview is public.
# Local devnet: CHAIN_RPC_PUBLIC_URL=http://127.0.0.1:8545
# CHAIN_RPC_PUBLIC_URL=
# ESCROW_ADDRESS=0x...
# ARBITER_REGISTRY_ADDRESS=0x...
# TIMELOCK_ADDRESS=0x...                             # owns the UUPS proxies
# There is no VAULT_ADDRESS: job budgets are held by the Escrow itself via
# lockBudget(jobRef), and publish verifies that tx on-chain.
# ADMIN_WALLETS=0x...,0x...
# Staking mirrors (must match apps/contracts/scripts/deploy.ts): prod 7d/3d,
# local (hardhat) 60s/60s. After an on-chain retune the indexer KV overrides env.
# MIN_STAKE_DURATION_SECONDS=604800
# UNSTAKE_COOLDOWN_SECONDS=259200
# Dispute windows (must match deploy.ts): prod 86400/86400/172800,
# local 120/120/600. Events carry no timestamps — the indexer derives deadlines.
# COMMIT_WINDOW_SECONDS=86400
# REVEAL_WINDOW_SECONDS=86400
# APPEAL_WINDOW_SECONDS=172800
# INDEXER_POLL_MS=10000                              # real-mode chain poll
# INDEXER_CONFIRMATIONS=5
# INDEXER_CHUNK_BLOCKS=2000

# ── Gasless sponsorship (ERC-2771 forwarder + server relayer) ───────────────
# Signed-in users sign ONE EIP-712 SponsorshipSession voucher at login; every
# money action is then submitted as a meta-tx by the relayer, which pays gas
# (+ principal on testnet). Both vars are required to enable it; unset → money
# actions fall back to normal user-paid gas.
# SPONSORSHIP_FORWARDER_ADDRESS=0x...   # from the deploy script output
# RELAYER_PRIVATE_KEY=0x...             # server-only testnet key; NEVER expose
# SPONSORSHIP_SESSION_TTL_SECONDS=43200 # default: mirrors SESSION_TTL_SECONDS
# SPONSORSHIP_RATE_LIMIT_PER_HOUR=60    # per-user drain guard

# ── Storage system (Supabase Storage when configured, else local disk) ──────
# Auto-selects `supabase` when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
# STORAGE_DRIVER=supabase                            # supabase | local
# STORAGE_BUCKET=project-files
# STORAGE_BUCKET_VISIBILITY=private                  # private | public
# STORAGE_PREFIX=                                    # object-key namespace, e.g. prod/
# STORAGE_ALLOWED_MIME=                              # CSV override of the default allowlist
# STORAGE_LOCAL_DIR=./data/uploads                   # local-driver disk root
# MAX_UPLOAD_BYTES=26214400                          # default 25 MiB, or 4 MiB when VERCEL is set; keep <= 4194304 (4 MiB) on Vercel, whose Functions reject request bodies over ~4.5 MB (uploads stream through PUT /api/files/:id/raw)
# SIGNED_URL_TTL_SECONDS=120                         # signed upload/download lifetime

# ── Display-only mirrors ───────────────────────────────────────────────────
# The contracts are authoritative; these seed UI copy before the first RPC read
# and let the indexer stamp commit/reveal deadlines.
# PLATFORM_FEE_BPS=250            # 2.5% platform fee
# DISPUTE_FEE_WEI=0                # free — the protocol funds the arbiters
# MIN_STAKE_WEI=100000000000000000
# MIN_SCORE_TO_WITHDRAW=50
# ARBITER_FEE_SHARE_BPS=2000      # arbiters take 20% of the fee
# ARBITER_AGREEMENT_WINDOW_HOURS=48
# ARBITER_SLA_HOURS=72

# ── Sessions & rate limits ─────────────────────────────────────────────────
# SESSION_TTL_SECONDS=43200      # JWT lifetime (12h)
# SIWE_NONCE_TTL_SECONDS=600
# SIWE_MAX_AGE_SECONDS=900
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_WRITE_PER_MIN=120
# RATE_LIMIT_READ_PER_MIN=600

# ── Workers & runtime ──────────────────────────────────────────────────────
# Run the indexer/crons/webhook delivery in this process. With Upstash
# configured the queue moves to Redis; otherwise these intervals live in the
# API process itself. Only src/serve.ts starts them: on Vercel nothing runs in
# the background, so INLINE_WORKERS and INDEXER_POLL_MS have no effect there and
# the scheduled work comes from GET /api/internal/cron (see CRON_SECRET above).
# INLINE_WORKERS=true
# LOG_LEVEL=info                 # debug | info | warn | error
# LOG_PRETTY=true

# NODE_ENV: `pnpm dev` sets development and `pnpm start` sets production. Dev-only
# routes, mirror auto-reset and the committed default JWT secret need it to be
# exactly `development`; anything else refuses to boot on the default secret.
# because it also flips on secure cookies, required HTTPS, and the dev-only
# /api/dev/stack guard (which spawns a shell and 404s outside development).
# NODE_ENV=production

